   "source": [
    "train_loader= DataLoader(dataset=train_data, batch_size=batch_size,shuffle=True)\n",
    "test_loader= DataLoader(dataset=test_data, batch_size=batch_size, shuffle=False)\n",
    "\n",
    "for images, labels in train_loader:     #loader processes the data into batches: 1 x 28 x28 is each image's dimension(grayscale), and 256 of them in one training sample\n",
    "    print(\"Image batch dimensions: \", images.shape)\n",
    "    print(\"Label batch dimensions: \", labels.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Model architecture"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Autoencoder(torch.nn.Module):\n",
    "    def __init__(self, num_features):   #take in the total number of features (size of each image)\n",
    "        super().__init__()\n",
    "\n",
    "        #encoder architecture  \n",
    "        self.linear_1= torch.nn.Linear(num_features,num_hidden_1)   #linear transformation to reduce the dimension from original to latent space\n",
    "        #self.linear by defaults uses the Xavier weight initialization with bias=0 \n",
    "\n",
    "        #we can customize the weight initialization to customize the weights such as \n",
    "        # self.linear_1.weight.detach().normal_(0.0,0.1)    customize weight initialization to mean 0, stand devi 0.1\n",
    "        # self.linear_1.bias.detach().zero_()   make bias into all zeros. \n",
    "        # Use detach() to not interfere with gradient descent  \n",
    "\n",
    "        #decoder (project back to original dimension from the latent space)\n",
    "        self.linear_2= torch.nn.Linear(num_hidden_1, num_features)\n",
    "\n",
    "    def forward(self, img): #input the image as the input \n",
    "        #go through encoder \n",
    "        encoded= self.linear_1(img)     #linear transformation \n",
    "        encoded= F.leaky_relu(encoded)  #non-linear activation function to finish transforming to the latent sapce\n",
    "\n",
    "        #decode \n",
    "        logits= self.linear_2(encoded)  #project back to original dimension \n",
    "        decoded= torch.sigmoid(logits)  #go through a different non-linear transformation to finish projecting \n",
    "        return decoded  #return newly generated image \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "torch.manual_seed(random_seed)  #deterministic model for reproducibility \n",
    "model= Autoencoder(num_features=num_features)   #num_features is our parameter \n",
    "model= model.to(device) #use cuda to process the model \n",
    "\n",
    "optimizer= torch.optim.Adam(model.parameters(), lr= learning_rate)  #use Adam optimizer with our learning rate"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Training the model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Epoch: 1/5 | Batch: 0/235 | cost: 0.6982\n",
      "Epoch: 1/5 | Batch: 50/235 | cost: 0.2348\n",
