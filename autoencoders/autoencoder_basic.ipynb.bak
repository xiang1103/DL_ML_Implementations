      "Epoch: 4/5 | Batch: 150/235 | cost: 0.1014\n",
      "Epoch: 4/5 | Batch: 200/235 | cost: 0.0990\n",
      "Time elapsed: 0.12 min\n",
      "Epoch: 5/5 | Batch: 0/235 | cost: 0.1005\n",
      "Epoch: 5/5 | Batch: 50/235 | cost: 0.1016\n",
      "Epoch: 5/5 | Batch: 100/235 | cost: 0.0980\n",
      "Epoch: 5/5 | Batch: 150/235 | cost: 0.1002\n",
